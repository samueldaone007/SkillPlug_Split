# =============================================================================
# SkillPlug Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# See DEPLOYMENT.md for the full production checklist.

# --- Core (required in production) ---
DEBUG=True
SECRET_KEY=your-secret-key-here

# --- Hosts & Origins (comma-separated, no spaces around commas) ---
ALLOWED_HOSTS=localhost,127.0.0.1
# ALLOWED_HOSTS=skillplug.onrender.com,localhost,127.0.0.1

# Set this to your deployed frontend URL (e.g. Vercel/Netlify/Render).
# Used for password-reset email links.
FRONTEND_URL=http://localhost:5173

# CORS_ALLOWED_ORIGINS must match FRONTEND_URL (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Database (PostgreSQL recommended for production) ---
# DATABASE_URL=postgres://username:password@localhost:5432/skillplug_db

# --- Email (for password reset) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@skillplug.ng

# --- Cloudinary (optional, for media file hosting) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp ---
WHATSAPP_DEFAULT_MESSAGE=Hello! I found you on SkillPlug and I'm interested in your services.
